  "global_classes": [
    {
      "id": "c00001",
      "name": "footer",
      "settings": {
        "_background": {
          "color": {
            "raw": "var(--secondary)"
          }
        },
        "_padding": {
          "top": "var(--section-space-m)",
          "bottom": "32px"
        },
        "_rowGap": "var(--section-space-m)"
      }
    },
    {
      "id": "c00002",
      "name": "footer__top",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "1.4fr 1fr 1fr 1fr",
        "_gridGap": "var(--container-gap)",
        "_gridTemplateColumns:tablet_portrait": "repeat(2, minmax(0, 1fr))",
        "_gridTemplateColumns:mobile_portrait": "1fr"
      }
    },
    {
      "id": "c00003",
      "name": "footer__brand",
      "settings": {
        "_rowGap": "var(--content-gap)",
        "_alignItems": "flex-start"
      }
    },
    {
      "id": "c00004",
      "name": "footer__logo",
      "settings": {
        "_height": "38px",
        "_width": "auto"
      }
    },
    {
      "id": "c00005",
      "name": "footer__address",
      "settings": {
        "_typography": {
          "color": {
            "raw": "color-mix(in srgb, var(--white) 70%, transparent)"
          },
          "font-size": "0.9375rem",
          "line-height": "1.6"
        }
      }
    },
    {
      "id": "c00006",
      "name": "footer__phone",
      "settings": {
        "_typography": {
          "color": {
            "raw": "var(--white)"
          },
          "font-weight": "700",
          "font-size": "0.9375rem"
        }
      }
    },
    {
      "id": "c00007",
      "name": "footer__col",
      "settings": {
        "_rowGap": "12px",
        "_alignItems": "flex-start"
      }
    },
    {
      "id": "c00008",
      "name": "footer__heading",
      "settings": {
        "_typography": {
          "font-size": "0.8125rem",
          "font-weight": "700",
          "letter-spacing": "0.08em",
          "text-transform": "uppercase",
          "color": {
            "raw": "var(--tertiary)"
          }
        },
        "_margin": {
          "bottom": "4px"
        }
      }
    },
    {
      "id": "c00009",
      "name": "footer__link",
      "settings": {
        "_typography": {
          "color": {
            "raw": "color-mix(in srgb, var(--white) 80%, transparent)"
          },
          "font-size": "0.9375rem"
        },
        "_cssTransition": "color 0.2s ease",
        "_typography:hover": {
          "color": {
            "raw": "var(--white)"
          }
        }
      }
    },
    {
      "id": "c00010",
      "name": "footer__bottom",
      "settings": {
        "_direction": "row",
        "_justifyContent": "space-between",
        "_alignItems": "center",
        "_padding": {
          "top": "24px"
        },
        "_border": {
          "width": {
            "top": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "color-mix(in srgb, var(--white) 12%, transparent)"
          }
        },
        "_direction:mobile_portrait": "column",
        "_rowGap:mobile_portrait": "16px"
      }
    },
    {
      "id": "c00011",
      "name": "footer__bottom-left",
