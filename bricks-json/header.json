            "raw": "var(--tertiary)"
          }
        }
      }
    },
    {
      "id": "c00007",
      "name": "util__divider",
      "settings": {
        "_border": {
          "width": {
            "left": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "color-mix(in srgb, var(--white) 25%, transparent)"
          }
        },
        "_height": "16px"
      }
    },
    {
      "id": "c00008",
      "name": "hdr",
      "settings": {
        "_background": {
          "color": {
            "raw": "var(--white)"
          }
        },
        "_padding": {
          "top": "16px",
          "bottom": "16px"
        },
        "_border": {
          "width": {
            "bottom": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "color-mix(in srgb, var(--secondary) 8%, transparent)"
          }
        }
      }
    },
    {
      "id": "c00009",
      "name": "hdr__inner",
      "settings": {
        "_direction": "row",
        "_justifyContent": "space-between",
        "_alignItems": "center",
        "_columnGap": "var(--container-gap)"
      }
    },
    {
      "id": "c00010",
      "name": "hdr__logo",
      "settings": {
        "_height": "42px",
        "_width": "auto"
      }
    },
    {
      "id": "c00011",
      "name": "hdr__nav",
      "settings": {
        "_direction": "row",
        "_alignItems": "center",
        "_columnGap": "4px"
      }
    },
    {
      "id": "c00012",
      "name": "hdr__link",
      "settings": {
        "_padding": {
          "top": "8px",
          "right": "16px",
          "bottom": "8px",
          "left": "16px"
        },
        "_typography": {
          "font-weight": "700",
          "font-size": "0.9375rem",
          "color": {
            "raw": "var(--secondary)"
          }
        },
        "_cssTransition": "color 0.2s ease",
        "_typography:hover": {
          "color": {
            "raw": "var(--primary)"
          }
        }
      }
    },
    {
      "id": "c00013",
      "name": "hdr__actions",
      "settings": {
        "_direction": "row",
        "_alignItems": "center",
        "_columnGap": "16px"
      }
    },
    {
      "id": "c00014",
      "name": "btn",
      "settings": {
        "_typography": {
          "font-weight": "800",
          "text-transform": "uppercase",
          "letter-spacing": "0.06em",
          "font-size": "0.8125rem"
        },
        "_padding": {
          "top": "0.9em",
          "right": "1.6em",
          "bottom": "0.9em",
          "left": "1.6em"
        },
        "_border": {
          "radius": {
            "top": "var(--radius)",
            "right": "var(--radius)",
            "bottom": "var(--radius)",
            "left": "var(--radius)"
          }
        },
        "_cssTransition": "transform 0.2s ease, box-shadow 0.3s ease, background-position 0.4s ease",
        "_transform:hover": {
          "translateY": "-2"
        }
      }
    },
    {
      "id": "c00015",
      "name": "btn--primary",
      "settings": {
        "_gradient": {
          "applyTo": "background",
          "gradientType": "linear",
          "angle": "135",
          "colors": [
            {
              "color": {
                "raw": "var(--primary)"
              },
              "stop": "0"
            },
            {
              "color": {
                "raw": "var(--tertiary)"
              },
              "stop": "100"
            }
          ]
        },
        "_typography": {
          "color": {
            "raw": "var(--secondary)"
          }
        },
        "_boxShadow": {
          "values": {
            "offsetX": "0",
            "offsetY": "16",
            "blur": "35",
            "spread": "0"
          },
          "color": {
            "raw": "color-mix(in srgb, var(--primary) 35%, transparent)"
          }
        }
      }
    }
  ],
  "globalVariables": []
