    {
      "id": "gc000a",
      "name": "crown-footer",
      "settings": {
        "_background": {
          "color": {
            "raw": "var(--neutral-dark)"
          }
        },
        "_padding": {
          "top": "var(--section-space-m)",
          "bottom": "var(--space-l)"
        }
      }
    },
    {
      "id": "gc000b",
      "name": "crown-footer__grid",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "1.2fr 1fr 1fr 1fr",
        "_gridGap": "var(--space-l)",
        "_width": "var(--content-width-safe)",
        "_gridTemplateColumns:tablet_portrait": "1fr 1fr",
        "_gridTemplateColumns:mobile_portrait": "1fr"
      }
    },
    {
      "id": "gc000c",
      "name": "crown-footer__col",
      "settings": {
        "_display": "flex",
        "_flexDirection": "column",
        "_rowGap": ".6rem"
      }
    },
    {
      "id": "gc000d",
      "name": "crown-footer__link",
      "settings": {
        "_typography": {
          "color": {
            "raw": "var(--neutral-light)"
          },
          "font-size": "var(--text-s)"
        }
      }
    },
    {
      "id": "gc000e",
      "name": "crown-footer__heading",
      "settings": {
        "_typography": {
          "font-size": "var(--text-s)",
          "font-weight": "700",
          "text-transform": "uppercase",
          "letter-spacing": "0.03em",
          "color": {
            "raw": "var(--white)"
          }
        }
      }
    },
    {
      "id": "gc000f",
      "name": "crown-footer__bottom",
      "settings": {
        "_display": "flex",
        "_justifyContent": "space-between",
        "_alignItems": "center",
        "_padding": {
          "top": "var(--space-m)"
        },
        "_margin": {
          "top": "var(--space-m)"
        },
        "_border": {
          "width": "1px 0 0 0",
          "style": "solid",
          "color": {
            "raw": "var(--neutral-dark)"
          }
        },
        "_typography": {
          "font-size": "var(--text-xs)",
          "color": {
            "raw": "var(--neutral-light)"
          }
        },
        "_flexWrap": "wrap",
        "_rowGap": ".5rem"
      }
    }
