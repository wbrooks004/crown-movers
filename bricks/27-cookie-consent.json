{
  "name": "cookie-consent-banner",
  "title": "Crown Movers — Cookie Consent Banner",
  "type": "content",
  "content": [
    {
      "id": "cbsec1",
      "name": "block",
      "parent": 0,
      "children": [
        "cbrow1"
      ],
      "settings": {
        "_cssGlobalClasses": [
          "9ma1ms"
        ],
        "_cssId": "cookie-banner",
        "_interactions": [
          {
            "id": "cbint1",
            "trigger": "contentLoaded",
            "action": "show",
            "target": "self",
            "delay": "1s",
            "interactionConditions": [
              {
                "conditionType": "localStorage",
                "storageKey": "cm_cookie_consent",
                "storageCompare": "notExists"
              }
            ]
          }
        ]
      },
      "label": "Cookie consent banner. [VERIFY] copy below is generic (“we use cookies”) because no confirmed list of cookies/tracking technologies actually in use on this site was found — update the copy to match whatever 25-page-privacy-policy.json's Cookies section ends up saying once that's confirmed, they need to agree. Show/hide-once and the Accept button's localStorage write both use documented, verified Bricks interaction mechanics (interactions.md's exit-intent-popup recipe uses the same storageAdd + interactionConditions pattern). What this does NOT do: actually gate any tracking script from firing before consent (real “consent mode” needs GTM/analytics-side wiring, which is outside what a static Bricks paste can set up) — if this site uses Google Analytics/Ads, wire real consent mode separately so “Reject” is not just cosmetic."
    },
    {
      "id": "cbrow1",
      "name": "block",
      "parent": "cbsec1",
      "children": [
        "cbtxt1",
        "cbact1"
      ],
      "settings": {
        "_cssGlobalClasses": [
          "5tb4wq"
        ]
      }
    },
    {
      "id": "cbtxt1",
      "name": "text-basic",
      "parent": "cbrow1",
      "children": [],
      "settings": {
        "text": "We use cookies to run this site and, where noted in our Privacy Policy, to understand how it's used. [VERIFY final copy once the Privacy Policy's Cookies section is confirmed]",
        "tag": "p",
        "_cssGlobalClasses": [
          "xhnran"
        ]
      }
    },
    {
      "id": "cbact1",
      "name": "block",
      "parent": "cbrow1",
      "children": [
        "cbrej1",
        "cback1"
      ],
      "settings": {
        "_cssGlobalClasses": [
          "karh0p"
        ]
      }
    },
    {
      "id": "cbrej1",
      "name": "button",
      "parent": "cbact1",
      "children": [],
      "settings": {
        "text": "Reject non-essential",
        "tag": "button",
        "_cssGlobalClasses": [
          "ekbqbq"
        ],
        "_interactions": [
          {
            "id": "cbint2",
            "trigger": "click",
            "action": "storageAdd",
            "storageType": "localStorage",
            "actionAttributeKey": "cm_cookie_consent",
            "actionAttributeValue": "rejected"
          },
          {
            "id": "cbint3",
            "trigger": "click",
            "action": "hide",
            "target": "custom",
            "targetSelector": "#cookie-banner"
          }
        ]
      }
    },
    {
      "id": "cback1",
      "name": "button",
      "parent": "cbact1",
      "children": [],
      "settings": {
        "text": "Accept",
        "tag": "button",
        "_cssGlobalClasses": [
          "f17nn7"
        ],
        "_interactions": [
          {
            "id": "cbint4",
            "trigger": "click",
            "action": "storageAdd",
            "storageType": "localStorage",
            "actionAttributeKey": "cm_cookie_consent",
            "actionAttributeValue": "accepted"
          },
          {
            "id": "cbint5",
            "trigger": "click",
            "action": "hide",
            "target": "custom",
            "targetSelector": "#cookie-banner"
          }
        ]
      }
    }
  ],
  "pageSettings": {},
  "templateSettings": {
    "templateConditions": [
      {
        "main": "hook",
        "hookName": "bricks_before_footer",
        "hookPriority": 10
      }
    ]
  },
  "global_classes": [
    {
      "id": "9ma1ms",
      "name": "cookie-banner",
      "settings": {
        "_position": "fixed",
        "_bottom": "0",
        "_left": "0",
        "_right": "0",
        "_zIndex": "200",
        "_background": {
