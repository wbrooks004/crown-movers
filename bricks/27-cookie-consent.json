          "bottom": "var(--space-s)",
          "left": "var(--space-m)"
        },
        "_boxShadow": {
          "values": {
            "offsetX": "0",
            "offsetY": "-8",
            "blur": "24",
            "spread": "0"
          },
          "color": {
            "rgb": "rgba(21,21,21,0.2)"
