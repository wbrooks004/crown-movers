        ]
      }
    },
    {
      "id": "tpsp011",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "By using crownmovers.ca, you agree to these Terms of Use. If you don't agree, please don't use this website.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh02",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Use of this website",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp021",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "This website is provided to give information about Crown Movers' services and to let you request a quote, request a moving estimate, or contact us. You agree to use it only for lawful purposes and not to interfere with its normal operation.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh03",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Quotes and estimates are not binding",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp031",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Any quote or moving-estimate figure you receive through this website — including the multi-step estimate tool — is a starting request, not a confirmed quote, contract, or booking. A Crown Movers team member confirms availability and final pricing directly with you before any move is booked. This matches the confirmation copy already used throughout the site's forms.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh04",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Intellectual property",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp041",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "The content, design, and branding on this website belong to Crown Movers unless otherwise noted. You may view and share pages for personal, non-commercial reference; you may not reproduce, resell, or otherwise use the content commercially without our written permission.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh05",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Third-party links",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp051",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "This site may link to third-party websites (for example, our Google Business Profile or social media pages). We don't control those sites and aren't responsible for their content or practices.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh06",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Limitation of liability",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp061",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "[VERIFY] This section needs to match Crown Movers' actual insurance, liability, and claims-handling terms for the moving services themselves (not just website use) — those are business-specific and shouldn't be drafted generically. Do not publish a liability section that overstates or understates real coverage.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
      "id": "tpsh07",
      "name": "heading",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "Governing law",
        "tag": "h2",
        "_cssGlobalClasses": [
          "v0amj7"
        ]
      }
    },
    {
      "id": "tpsp071",
      "name": "text-basic",
      "parent": "tpbody1",
      "children": [],
      "settings": {
        "text": "These terms are governed by the laws of the Province of Quebec and the federal laws of Canada applicable in Quebec.",
        "tag": "p",
        "_cssGlobalClasses": [
          "gu6f2l"
        ]
      }
    },
    {
