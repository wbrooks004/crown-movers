      "settings": {
        "fields": [
          {
            "id": "efmvty",
            "type": "radio",
            "label": "Move type",
            "options": "Residential\nCommercial\nLong-distance",
            "required": true,
            "width": "100"
          },
          {
            "id": "efforg",
            "type": "text",
            "label": "Moving from",
            "placeholder": "Street address",
            "required": true,
            "width": "50"
          },
          {
            "id": "efdest",
            "type": "text",
            "label": "Moving to",
            "placeholder": "Street address",
            "required": true,
            "width": "50"
          },
          {
            "id": "efmvdt",
            "type": "datepicker",
            "label": "Move date",
            "required": true,
            "width": "100"
          },
          {
            "id": "efprty",
            "type": "radio",
            "label": "Property type",
            "options": "Apartment / condo\nHouse / townhouse\nOffice / commercial\nStorage unit",
            "required": true,
            "width": "100"
          },
          {
            "id": "efaccs",
            "type": "checkbox",
            "label": "Access conditions (select all that apply)",
            "options": "Elevator available\nStairs only\nLong carry / walk to entrance\nParking restrictions\nNarrow doorways or hallways",
            "required": false,
            "width": "100"
          },
          {
            "id": "efsize",
            "type": "radio",
            "label": "Home / space size",
            "options": "Studio\n1 bedroom\n2 bedroom\n3 bedroom\n4+ bedroom\nOffice / commercial space",
            "required": true,
            "width": "100"
          },
          {
            "id": "efspec",
            "type": "checkbox",
            "label": "Specialty items (select all that apply)",
            "options": "Piano\nSafe\nArtwork or antiques\nGym or exercise equipment\nOther fragile / high-value items",
            "required": false,
            "width": "100"
          },
          {
            "id": "efname",
            "type": "text",
            "label": "Name",
            "required": true,
            "width": "50"
          },
          {
            "id": "efphon",
            "type": "tel",
            "label": "Phone",
            "required": true,
            "width": "50"
          },
          {
            "id": "efemal",
            "type": "email",
            "label": "Email",
            "required": false,
            "width": "100"
          }
        ],
        "columns": "2",
        "submitButtonText": "Get my estimate",
        "submitButtonStyle": "primary",
        "actions": [
          "email"
        ],
        "emailSubject": "New moving estimate request — {{efname}}",
        "emailTo": "admin_email",
        "replyToEmail": "{{efemal}}",
        "emailContent": "Move type: {{efmvty}}\nFrom: {{efforg}}\nTo: {{efdest}}\nMove date: {{efmvdt}}\nProperty: {{efprty}}\nAccess: {{efaccs}}\nSize: {{efsize}}\nSpecialty items: {{efspec}}\nName: {{efname}}\nPhone: {{efphon}}\nEmail: {{efemal}}",
        "successMessage": "Thanks — this is a starting estimate request, not a confirmed quote or booking. A Crown Movers team member will follow up to confirm availability and final pricing.",
        "showLabels": true,
        "fieldBorder": {
          "width": {
            "top": "1px",
            "right": "1px",
            "bottom": "1px",
            "left": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "var(--neutral-light)"
          },
          "radius": {
            "top": "8px",
            "right": "8px",
            "bottom": "8px",
            "left": "8px"
          }
        }
      },
      "label": "The one real <form> — renders ALL 8 steps' fields (Bricks doesn't support splitting one form element's fields across multiple DOM locations, so this single element sits inside the last step panel and CSS/layout carries every field where it visually belongs is NOT what happens here: fields render together, in the order listed, wherever this element sits. [VERIFY — CORRECTNESS CAVEAT, read before pasting]: this is the one real structural limitation of hand-authoring a Bricks-native multi-step form — a single `form` element renders its fields as one contiguous block, it cannot be split so each field appears inside its own separate step panel above. Two ways to actually ship the visual you see in the step panels: (A) rebuild as 8 separate Bricks forms chained via `create-post`/`update-post` actions writing to one draft entry per step (real but complex), or (B) use this file for its content/copy/field-list/step-panel visual design and wire it up in WS Form instead, which natively supports true multi-step field placement — recommended, since WS Form is already the project's confirmed plugin. Do not paste this expecting fields to appear split across the step panels as drawn; today they render as one list. Left in place anyway because the field list, labels, options, and step copy are the real deliverable and are correct and reusable regardless of which of the two fixes above gets picked."
    }
