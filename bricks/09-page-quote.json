    {
      "id": "qffrm1",
      "name": "form",
      "parent": "qfcrd1",
      "children": [],
      "settings": {
        "fields": [
          {
            "id": "qffdat",
            "type": "datepicker",
            "label": "Move date",
            "required": true,
            "width": "50"
          },
          {
            "id": "qfftyp",
            "type": "select",
            "label": "Move type",
            "options": "Residential\nCommercial\nLong distance",
            "required": true,
            "width": "50"
          },
          {
            "id": "qffor1",
            "type": "text",
            "label": "Moving from",
            "placeholder": "Street address",
            "required": true,
            "width": "50"
          },
          {
            "id": "qffde1",
            "type": "text",
            "label": "Moving to",
            "placeholder": "Street address",
            "required": true,
            "width": "50"
          },
          {
            "id": "qffnam",
            "type": "text",
            "label": "Name",
            "required": true,
            "width": "50"
          },
          {
            "id": "qffphn",
            "type": "tel",
            "label": "Phone",
            "required": true,
            "width": "50"
          },
          {
            "id": "qffdet",
            "type": "textarea",
            "label": "Access details or specialty items",
            "placeholder": "Stairs, elevator, parking, piano, etc. (optional)",
            "required": false,
            "width": "100"
          }
        ],
        "columns": "2",
        "submitButtonText": "Request my quote",
        "submitButtonStyle": "primary",
        "actions": [
          "email"
        ],
        "emailSubject": "New quote request — {{qffnam}}",
        "emailTo": "admin_email",
        "replyToEmail": "{{qffphn}}",
        "emailContent": "Name: {{qffnam}}\nPhone: {{qffphn}}\nMove date: {{qffdat}}\nMove type: {{qfftyp}}\nFrom: {{qffor1}}\nTo: {{qffde1}}\nDetails: {{qffdet}}",
        "successMessage": "Thanks — this is a request, not a confirmed quote. A Crown Movers team member will follow up to confirm availability and pricing.",
        "showLabels": true,
        "fieldBorder": {
          "width": {
            "top": "1px",
            "right": "1px",
            "bottom": "1px",
            "left": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "var(--neutral-light)"
          },
          "radius": {
            "top": "8px",
            "right": "8px",
            "bottom": "8px",
            "left": "8px"
          }
        }
      },
      "label": "[TODO] actions=email (admin_email) is a working default — swap to a webhook action + real n8n endpoint once that destination is decided. [VERIFY] submit button uses theme-style \"primary\" (coral bg from 00-theme-styles.json); confirm its text renders as dark ink (--base) not white — set manually in the Style tab if not."
    },
