    },
    {
      "id": "mbsec1",
      "name": "section",
      "parent": 0,
      "children": ["mbct01", "mbct02"],
      "label": "Mobile Sticky Actions — fixed bottom bar, mobile only. Add body{padding-bottom:64px} via Page Settings → Custom CSS on pages using this footer so content doesn't sit under it.",
      "settings": {
        "tag": "div",
        "_position": "fixed",
        "_bottom": "0",
        "_left": "0",
        "_right": "0",
        "_zIndex": "110",
        "_display": "none",
        "_display:mobile_landscape": "grid",
        "_gridTemplateColumns:mobile_landscape": "1fr 1fr",
        "_gridGap": "8px",
        "_padding": { "top": "10px", "right": "10px", "bottom": "10px", "left": "10px" },
        "_background": { "color": { "hex": "#FFFFFF" } },
        "_border": { "width": { "top": "1px" }, "style": "solid", "color": { "raw": "var(--neutral-light)" } },
        "_boxShadow": { "values": { "offsetX": "0", "offsetY": "-12", "blur": "32", "spread": "0" }, "color": { "rgb": "rgba(21,21,21,0.12)" } }
      }
    },
    {
      "id": "mbct01",
      "name": "button",
      "parent": "mbsec1",
      "children": [],
      "label": "[VERIFY] placeholder phone number",
      "settings": {
        "text": "Call",
        "tag": "a",
        "link": { "type": "external", "url": "tel:+10000000000" },
        "icon": { "library": "ionicons", "icon": "ion-ios-call" },
        "iconPosition": "left",
        "_background": { "raw": "var(--base)" },
        "_typography": { "color": { "hex": "#FFFFFF" }, "font-weight": "750" },
        "_border": { "radius": { "top": "8px", "right": "8px", "bottom": "8px", "left": "8px" } },
        "_heightMin": "44px",
        "_justifyContent": "center"
      }
    },
    {
      "id": "mbct02",
      "name": "button",
      "parent": "mbsec1",
      "children": [],
