  "source": "bricksCopiedElements",
  "sourceUrl": "https://www.crownmovers.ca/",
  "version": "2.3.6",
  "globalClasses": [
    {
      "id": "svcgrid",
      "name": "service-grid",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "repeat(3, minmax(0, 1fr))",
        "_gridGap": "var(--space-l)",
        "_gridTemplateColumns:tablet_portrait": "repeat(2, minmax(0, 1fr))",
        "_gridTemplateColumns:mobile_landscape": "1fr"
      }
    },
    {
      "id": "svccard",
      "name": "service-card",
      "settings": {
        "_display": "flex",
        "_flexDirection": "column",
        "_overflow": "hidden",
        "_background": { "color": { "hex": "#FFFFFF" } },
        "_border": { "width": { "top": "1px", "right": "1px", "bottom": "1px", "left": "1px" }, "style": "solid", "color": { "raw": "var(--neutral-light)" }, "radius": { "top": "12px", "right": "12px", "bottom": "12px", "left": "12px" } },
        "_boxShadow": { "values": { "offsetX": "0", "offsetY": "8", "blur": "24", "spread": "-8" }, "color": { "rgb": "rgba(21,21,21,0.07)" } },
        "_cssTransition": "transform 0.2s ease, box-shadow 0.2s ease",
        "_transform:hover": { "translateY": "-3" },
        "_boxShadow:hover": { "values": { "offsetX": "0", "offsetY": "16", "blur": "32", "spread": "-8" }, "color": { "rgb": "rgba(21,21,21,0.14)" } }
      }
    },
    {
      "id": "svcimg",
      "name": "service-card__image",
      "settings": { "_aspectRatio": "16/10", "_objectFit": "cover", "_width": "100%" }
    },
    {
      "id": "svcbody",
      "name": "service-card__body",
      "settings": { "_display": "flex", "_flexDirection": "column", "_flexGrow": "1", "_rowGap": "var(--space-s)", "_padding": { "top": "var(--space-m)", "right": "var(--space-m)", "bottom": "var(--space-m)", "left": "var(--space-m)" } }
    },
    {
      "id": "svceyebrow",
      "name": "service-card__eyebrow",
      "settings": { "_typography": { "font-size": "1.25rem", "font-weight": "800", "letter-spacing": "0.09em", "text-transform": "uppercase", "color": { "raw": "var(--accent)" } } }
    },
    {
      "id": "svctext",
      "name": "service-card__text",
      "settings": { "_typography": { "color": { "raw": "var(--neutral-dark)" } }, "_flexGrow": "1" }
    },
    {
      "id": "svclink",
      "name": "service-card__link",
      "settings": {
        "_typography": { "font-weight": "800", "color": { "raw": "var(--base)" } },
        "_margin": { "top": "auto" },
        "_cssTransition": "color 0.16s ease",
        "_typography:hover": { "color": { "raw": "var(--primary)" } }
      }
    }
  ],
  "globalElements": []
}
