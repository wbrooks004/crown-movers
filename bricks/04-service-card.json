  "globalClasses": [
    {
      "id": "cae3bc",
      "name": "u-gap-2xs",
      "settings": {
        "_columnGap": "var(--space-2xs)",
        "_rowGap": "var(--space-2xs)"
      }
    },
    {
      "id": "cf0315",
      "name": "u-gap-xl",
      "settings": {
        "_columnGap": "var(--space-xl)",
        "_rowGap": "var(--space-xl)"
      }
    },
    {
      "id": "c80a54",
      "name": "u-max-m",
      "settings": {
        "_widthMax": "760px"
      }
    },
    {
      "id": "c457c7",
      "name": "u-pad-2xl-y",
      "settings": {
        "_padding": {
          "top": "var(--space-2xl)",
          "bottom": "var(--space-2xl)"
        }
      }
    },
    {
      "id": "c72e04",
      "name": "eyebrow",
      "settings": {
        "_typography": {
          "font-size": "1.25rem",
          "font-weight": "800",
          "letter-spacing": "0.11em",
          "text-transform": "uppercase",
          "color": {
            "raw": "var(--primary)"
          }
        }
      }
    },
    {
      "id": "c1b54d",
      "name": "body-text",
      "settings": {
        "_typography": {
          "color": {
            "raw": "var(--neutral-dark)"
          }
        }
      }
    },
    {
      "id": "c285a4",
      "name": "u-bg-white",
      "settings": {
        "_background": {
          "color": {
            "hex": "#FFFFFF"
          }
        }
      }
    },
    {
      "id": "cc161e",
      "name": "card-surface",
      "settings": {
        "_background": {
          "color": {
            "hex": "#FFFFFF"
          }
        },
        "_border": {
          "width": {
            "top": "1px",
            "right": "1px",
            "bottom": "1px",
            "left": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "var(--neutral-light)"
          },
          "radius": {
            "top": "12px",
            "right": "12px",
            "bottom": "12px",
            "left": "12px"
          }
        },
        "_boxShadow": {
          "values": {
            "offsetX": "0",
            "offsetY": "8",
            "blur": "24",
            "spread": "-8"
          },
          "color": {
            "rgb": "rgba(21,21,21,0.07)"
          }
        }
      }
    },
    {
      "id": "cb8f51",
      "name": "card-hover-lift",
      "settings": {
        "_cssTransition": "transform 0.2s ease, box-shadow 0.2s ease",
        "_transform:hover": {
          "translateY": "-3"
        },
        "_boxShadow:hover": {
          "values": {
            "offsetX": "0",
            "offsetY": "16",
            "blur": "32",
            "spread": "-8"
          },
          "color": {
            "rgb": "rgba(21,21,21,0.14)"
          }
        }
      }
    },
    {
      "id": "c5f7d2",
      "name": "service-grid",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "repeat(3, minmax(0, 1fr))",
        "_gridGap": "var(--space-l)",
        "_gridTemplateColumns:tablet_portrait": "repeat(2, minmax(0, 1fr))",
        "_gridTemplateColumns:mobile_landscape": "1fr"
      }
    },
    {
      "id": "c614b5",
      "name": "service-card",
      "settings": {
        "_display": "flex",
        "_flexDirection": "column",
        "_overflow": "hidden"
      }
    },
    {
      "id": "c1d3fa",
      "name": "service-card__image",
      "settings": {
        "_aspectRatio": "16/10",
        "_objectFit": "cover",
        "_width": "100%"
      }
    },
    {
      "id": "c891a8",
      "name": "service-card__body",
      "settings": {
        "_display": "flex",
        "_flexDirection": "column",
        "_flexGrow": "1",
        "_rowGap": "var(--space-s)",
        "_padding": {
          "top": "var(--space-m)",
          "right": "var(--space-m)",
          "bottom": "var(--space-m)",
          "left": "var(--space-m)"
        }
      }
    },
    {
      "id": "c59a75",
      "name": "service-card__eyebrow",
      "settings": {
        "_typography": {
          "font-size": "1.25rem",
          "font-weight": "800",
          "letter-spacing": "0.09em",
          "text-transform": "uppercase",
          "color": {
            "raw": "var(--accent)"
          }
        }
      }
    },
    {
      "id": "c28fb5",
      "name": "service-card__text",
      "settings": {
        "_typography": {
          "color": {
            "raw": "var(--neutral-dark)"
          }
        },
        "_flexGrow": "1"
      }
    },
    {
      "id": "c15017",
      "name": "service-card__link",
      "settings": {
        "_typography": {
          "font-weight": "800",
          "color": {
            "raw": "var(--base)"
          }
        },
        "_margin": {
          "top": "auto"
        },
        "_cssTransition": "color 0.16s ease",
        "_typography:hover": {
          "color": {
            "raw": "var(--primary)"
          }
        }
      }
    }
  ],
