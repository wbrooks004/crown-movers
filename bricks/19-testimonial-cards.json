  "globalClasses": [
    {
      "id": "9snird",
      "name": "u-bg-warm",
      "settings": {
        "_background": {
          "color": {
            "hex": "#F7F5F1"
          }
        }
      }
    },
    {
      "id": "ifueps",
      "name": "u-pad-2xl-y",
      "settings": {
        "_padding": {
          "top": "var(--space-2xl)",
          "bottom": "var(--space-2xl)"
        }
      }
    },
    {
      "id": "0suz6r",
      "name": "u-gap-xl",
      "settings": {
        "_columnGap": "var(--space-xl)",
        "_rowGap": "var(--space-xl)"
      }
    },
    {
      "id": "4hfab1",
      "name": "u-gap-2xs",
      "settings": {
        "_columnGap": "var(--space-2xs)",
        "_rowGap": "var(--space-2xs)"
      }
    },
    {
      "id": "ytu6ik",
      "name": "u-max-m",
      "settings": {
        "_widthMax": "760px"
      }
    },
    {
      "id": "day68t",
      "name": "u-text-center",
      "settings": {
        "_typography": {
          "text-align": "center"
        }
      }
    },
    {
      "id": "m7za52",
      "name": "eyebrow",
      "settings": {
        "_typography": {
          "font-size": "1.25rem",
          "font-weight": "800",
          "letter-spacing": "0.11em",
          "text-transform": "uppercase",
          "color": {
            "raw": "var(--primary)"
          }
        }
      }
    },
    {
      "id": "b55yye",
      "name": "testimonial-grid",
      "settings": {
        "_display": "grid",
        "_gridTemplateColumns": "repeat(3, minmax(0, 1fr))",
        "_gridGap": "var(--space-l)",
        "_gridTemplateColumns:tablet_portrait": "repeat(2, minmax(0, 1fr))",
        "_gridTemplateColumns:mobile_landscape": "1fr"
      }
    },
    {
      "id": "xv16e0",
      "name": "testimonial-card",
      "settings": {
        "_display": "flex",
        "_flexDirection": "column",
        "_rowGap": "var(--space-s)",
        "_padding": {
          "top": "var(--space-l)",
          "right": "var(--space-l)",
          "bottom": "var(--space-l)",
          "left": "var(--space-l)"
        }
      }
    },
    {
      "id": "tnef81",
      "name": "testimonial-card__stars",
      "settings": {
        "_direction": "row",
        "_columnGap": "2px",
        "_typography": {
          "color": {
            "raw": "var(--accent)"
          },
          "font-size": "1.6rem"
        }
      }
    },
    {
      "id": "rixtsm",
      "name": "testimonial-card__quote",
      "settings": {
        "_typography": {
          "color": {
            "raw": "var(--neutral-dark)"
          }
        },
        "_flexGrow": "1"
      }
    },
    {
      "id": "unakyi",
      "name": "testimonial-card__byline-row",
      "settings": {
        "_direction": "row",
        "_alignItems": "center",
        "_columnGap": "var(--space-2xs)"
      }
    },
    {
      "id": "i693gk",
      "name": "testimonial-card__photo",
      "settings": {
        "_width": "40px",
        "_height": "40px",
        "_widthMin": "40px",
        "_aspectRatio": "1/1",
        "_objectFit": "cover",
        "_border": {
          "radius": {
            "top": "999px",
            "right": "999px",
            "bottom": "999px",
            "left": "999px"
          }
        }
      }
    },
    {
      "id": "lnpgbk",
      "name": "testimonial-card__name",
      "settings": {
        "_typography": {
          "font-weight": "700",
          "color": {
            "raw": "var(--base)"
          }
        }
      }
    },
    {
      "id": "3fvlia",
      "name": "testimonial-card__location",
      "settings": {
        "_typography": {
          "font-size": "1.25rem",
          "color": {
            "raw": "var(--neutral)"
          }
        }
      }
    },
    {
      "id": "7tuo1p",
      "name": "card-surface",
      "settings": {
        "_background": {
          "color": {
            "hex": "#FFFFFF"
          }
        },
        "_border": {
          "width": {
            "top": "1px",
            "right": "1px",
            "bottom": "1px",
            "left": "1px"
          },
          "style": "solid",
          "color": {
            "raw": "var(--neutral-light)"
          },
          "radius": {
            "top": "12px",
            "right": "12px",
            "bottom": "12px",
            "left": "12px"
          }
        },
        "_boxShadow": {
          "values": {
            "offsetX": "0",
            "offsetY": "8",
            "blur": "24",
            "spread": "-8"
          },
          "color": {
            "rgb": "rgba(21,21,21,0.07)"
          }
        }
      }
    }
  ],
